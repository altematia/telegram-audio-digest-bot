TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# Either list allowed Telegram IDs, or set a random claim secret (16+ characters)
# and send `/claim <secret>` to the bot once. Never leave both blank.
ALLOWED_USER_IDS=
BOT_CLAIM_SECRET=

# Optional SOCKS/HTTP proxy for Telegram only (for example, socks5://127.0.0.1:40000).
TELEGRAM_PROXY_URL=

# OpenAI recommends gpt-transcribe for recorded speech.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_SUMMARY_MODEL=gpt-5.6-terra

DATABASE_PATH=data/bot.sqlite3
MAX_FILE_SIZE_MB=20
TRANSCRIPT_RETENTION_DAYS=30
OPENAI_TIMEOUT_SECONDS=240
FFMPEG_BIN=ffmpeg
LOG_LEVEL=INFO
MAX_CONCURRENT_UPDATES=4
